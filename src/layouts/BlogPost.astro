---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type NavigationPost = {
	id: string;
	title: string;
};

type Props = CollectionEntry<'blog'>['data'] & {
	previousPost?: NavigationPost;
	nextPost?: NavigationPost;
};

const {
	title,
	description,
	pubDate,
	pubDateCalendarDate,
	updatedDate,
	heroImage,
	previousPost,
	nextPost,
} = Astro.props;

const blogPostingSchema = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	...(updatedDate && { dateModified: updatedDate.toISOString() }),
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': Astro.url.href,
	},
	...(heroImage && {
		image: [new URL(heroImage.src, Astro.url.origin).href],
	}),
};

---

<html lang="en">
	<head>
	<BaseHead title={title} description={description} />
	<script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
	<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
	display: block;
	width: auto;
	max-width: 100%;
	max-height: 75vh;
	height: auto;
	margin: 0 auto;
	border-radius: 12px;
	box-shadow: var(--box-shadow);
}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.post-navigation {
	display: grid;
	grid-template-columns: 1fr auto 1fr;
	align-items: center;
	gap: 1rem;
	margin: 3rem 0 2rem;
	padding-top: 1.5rem;
	border-top: 1px solid rgb(var(--gray-light));
}

.post-navigation a {
	display: inline-block;
	padding: 0.65em 1em;
	border: 1px solid var(--accent);
	border-radius: 8px;
	background: var(--paper);
	color: var(--accent-dark);
	font-weight: 700;
	text-decoration: none;
	transition: 0.2s ease;
}

.post-navigation a:hover {
	background: var(--accent);
	color: var(--surface);
}

.post-navigation a:focus-visible {
	outline: 3px solid var(--accent);
	outline-offset: 3px;
}

.previous-post {
	grid-column: 1;
	justify-self: start;
}

.home-post {
	grid-column: 2;
	justify-self: center;
}

.next-post {
	grid-column: 3;
	justify-self: end;
}

@media (max-width: 520px) {
	.post-navigation {
		grid-template-columns: 1fr;
	}

	.previous-post,
	.home-post,
	.next-post {
		grid-column: 1;
		justify-self: stretch;
		text-align: center;
	}
}

.post-navigation a:hover {
	background: var(--accent);
	color: var(--surface);
}

.post-navigation a:focus-visible {
	outline: 3px solid var(--accent);
	outline-offset: 3px;
}

.previous-post {
	grid-column: 1;
	justify-self: start;
}

.home-post {
	grid-column: 2;
	justify-self: center;
}

.next-post {
	grid-column: 3;
	justify-self: end;
}

		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
	<h1>{title}</h1>

	<div class="date">
		<FormattedDate date={pubDate} calendarDate={pubDateCalendarDate} />
		{
			updatedDate && (
				<div class="last-updated-on">
					Last updated on <FormattedDate date={updatedDate} />
				</div>
			)
		}
	</div>

	<hr />
</div>
										<slot />

<nav class="post-navigation" aria-label="Post navigation">
	{previousPost && (
		<a class="previous-post" href={`/blog/${previousPost.id}/`}>
			← Previous Post
		</a>
	)}

	<a class="home-post" href="/">
		Home
	</a>

	{nextPost && (
		<a class="next-post" href={`/blog/${nextPost.id}/`}>
			Next Post →
		</a>
	)}
</nav>

<script
	src="https://giscus.app/client.js"
						data-repo="handedthekeys/handedthekeys.github.io"
						data-repo-id="R_kgDOTwmksg"
						data-category="Announcements"
						data-category-id="DIC_kwDOTwmkss4DC6VO"
						data-mapping="pathname"
						data-strict="1"
						data-reactions-enabled="1"
						data-emit-metadata="0"
						data-input-position="bottom"
						data-theme="https://handedthekeys.github.io/giscus-theme.css"
						data-lang="en"
						data-loading="lazy"
						crossorigin="anonymous"
						async
					></script>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
