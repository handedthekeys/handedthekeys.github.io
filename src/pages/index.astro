---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { DEFAULT_POST_IMAGE, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const latestPost = posts[0];
const recentPosts = posts.slice(1, 4);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}

			.intro {
				margin-bottom: 4rem;
				text-align: center;
			}

			.intro h1 {
				margin-bottom: 0.25em;
			}

			.intro .tagline {
				margin-top: 0;
				font-size: 1.25rem;
				color: rgb(var(--gray));
			}

			.latest-story {
	margin-bottom: 4rem;
}

.latest-feature {
	display: grid;
	grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
	gap: 2.5rem;
	align-items: center;
}

.latest-story img {
	display: block;
	width: auto;
	max-width: 100%;
	max-height: 520px;
	height: auto;
	margin: 0 auto;
	border-radius: 12px;
	box-shadow: var(--box-shadow);
}

.latest-copy {
	min-width: 0;
}

			.section-label {
				margin-bottom: 0.5rem;
				font-size: 0.85rem;
				font-weight: 700;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: rgb(var(--gray));
			}

			.story-date {
				margin: 0 0 0.5rem;
				color: rgb(var(--gray));
			}

			.latest-story h2 {
				margin: 0 0 0.5rem;
			}

			.latest-story a,
			.recent-stories a {
				text-decoration: none;
			}

			.latest-story h2,
			.recent-stories h3 {
				color: rgb(var(--black));
			}

			.read-more {
				font-weight: 700;
			}

			.recent-stories {
				margin-bottom: 4rem;
			}

			.story-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 2rem;
			}

			.story-card img {
				width: 100%;
				margin-bottom: 1rem;
				border-radius: 12px;
			}

			.story-card h3 {
				margin: 0 0 0.5rem;
			}

			.story-card p {
				margin-top: 0.5rem;
			}

			.about {
				margin-bottom: 2rem;
				padding-top: 2rem;
				border-top: 1px solid rgb(var(--gray-light));
			}

			@media (max-width: 720px) {
	.intro,
	.latest-story,
	.recent-stories {
		margin-bottom: 3rem;
	}

	.latest-feature,
	.story-grid {
		grid-template-columns: 1fr;
	}

	.latest-feature {
		gap: 1.5rem;
	}
}
		</style>
	</head>

	<body>
		<Header />

		<main>
			<section class="intro">
				<h1>{SITE_TITLE}</h1>
				<p class="tagline">{SITE_DESCRIPTION}</p>
				<p>
					A personal blog about working life, the places it takes me,
					and the stories that come with whatever happens next.
				</p>
			</section>

			{
	latestPost && (
		<section class="latest-story">
			<p class="section-label">Latest Post</p>

			<div class="latest-feature">
				<a href={`/blog/${latestPost.id}/`}>
					<Image
						width={960}
						src={latestPost.data.heroImage ?? DEFAULT_POST_IMAGE}
						alt=""
					/>
				</a>

				<div class="latest-copy">
					<p class="story-date">
						<FormattedDate date={latestPost.data.pubDate} />
					</p>

					<a href={`/blog/${latestPost.id}/`}>
						<h2>{latestPost.data.title}</h2>
					</a>

					<p>{latestPost.data.description}</p>

					<a class="read-more" href={`/blog/${latestPost.id}/`}>
						Read the post →
					</a>
				</div>
			</div>
		</section>
	)
}

			{
				recentPosts.length > 0 && (
					<section class="recent-stories">
						<p class="section-label">Recent Posts</p>

						<div class="story-grid">
							{recentPosts.map((post) => (
								<article class="story-card">
									<a href={`/blog/${post.id}/`}>
										<Image
	width={720}
	src={post.data.heroImage ?? DEFAULT_POST_IMAGE}
	alt=""
/>

										<p class="story-date">
											<FormattedDate date={post.data.pubDate} />
										</p>

										<h3>{post.data.title}</h3>
									</a>

									<p>{post.data.description}</p>
								</article>
							))}
						</div>
					</section>
				)
			}

			<section class="about">
				<p class="section-label">About Handed the Keys</p>

				<p>
					Handed the Keys began with the experience of substitute teaching:
					another assignment, another set of keys, and another story.
					It is a place to write about the working week and wherever
					professional life leads next.
				</p>

				<a class="read-more" href="/about/">About the blog →</a>
			</section>
		</main>

		<Footer />
	</body>
</html>
