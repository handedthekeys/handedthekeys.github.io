---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { DEFAULT_POST_IMAGE, SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import PORTRAIT_POST_BACKGROUND from '../../assets/handed-the-keys-default-post-portrait.png';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			.archive-media {
	display: flex;
	justify-content: center;
	width: fit-content;
	max-width: 100%;
	margin: 0 auto 1.5rem;
	overflow: hidden;
	border-radius: 12px;
}

.archive-media img {
	display: block;
	width: auto;
	max-width: 100%;
	max-height: 360px;
	height: auto;
	border-radius: 12px;
}

ul li:first-child .archive-media img {
	max-height: 520px;
}

.archive-media.portrait {
	width: 100%;
	align-items: center;
	aspect-ratio: 16 / 9;
	background-size: cover;
	background-position: center;
}

.archive-media.portrait img {
	width: auto;
	max-width: 100%;
	height: 100%;
	max-height: none;
	object-fit: contain;
	border-radius: 0;
}
			ul li:first-child .title {
				font-size: 2.369rem;
			}
			.archive-media {
	display: flex;
	justify-content: center;
	max-width: 100%;
	margin: 0 auto 1.5rem;
	overflow: hidden;
	border-radius: 12px;
}

.archive-media img {
	display: block;
	width: auto;
	max-width: 100%;
	max-height: 360px;
	height: auto;
	border-radius: 12px;
}

ul li:first-child .archive-media img {
	max-height: 520px;
}

.archive-media.portrait {
	align-items: center;
	aspect-ratio: 16 / 9;
	background-size: cover;
	background-position: center;
}

.archive-media.portrait img {
	width: auto;
	max-width: 100%;
	height: 100%;
	max-height: none;
	object-fit: contain;
	border-radius: 0;
}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			.description {
	margin: 0.75rem 0 0;
	color: rgb(var(--gray));
	line-height: 1.6;
}
			ul li a:hover h4,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}

			.archive-media {
	transition: box-shadow 0.2s ease;
}
			ul a:hover .archive-media {
	box-shadow:
		var(--box-shadow),
		0 0 0 2px var(--accent);
}

@media (max-width: 720px) {
	ul {
		gap: 0.5em;
	}
	ul li {
		width: 100%;
		text-align: center;
	}
	ul li:first-child {
		margin-bottom: 0;
	}
	ul li:first-child .title {
		font-size: 1.563em;
	}
}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
	<a href={`/blog/${post.id}/`}>
		<div
	class:list={[
		'archive-media',
		{
			portrait:
				post.data.heroImage &&
				post.data.heroImage.height > post.data.heroImage.width,
		},
	]}
	style={
		post.data.heroImage &&
		post.data.heroImage.height > post.data.heroImage.width
			? `background-image: url(${PORTRAIT_POST_BACKGROUND.src});`
			: undefined
	}
>
	<Image
		width={720}
		src={post.data.heroImage ?? DEFAULT_POST_IMAGE}
		alt=""
	/>
</div>
		<h4 class="title">{post.data.title}</h4>
		<p class="date">
	<FormattedDate
		date={post.data.pubDate}
		calendarDate={post.data.pubDateCalendarDate}
	/>
</p>
<p class="description">{post.data.description}</p>
	</a>
</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
